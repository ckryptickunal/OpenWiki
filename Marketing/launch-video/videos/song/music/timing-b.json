{"lines":[{"text":"Ooh","start":0.0,"end":5.2},{"text":"Lost in the quiet","start":6.1,"end":10.3},{"text":"I watched a thousand hours of life","start":16.4,"end":22.8},{"text":"Saved every word","start":23.9,"end":25.9},{"text":"Then lost it overnight","start":26.2,"end":30.0},{"text":"Now every talk","start":31.9,"end":33.6},{"text":"Every page I read","start":33.9,"end":35.4},{"text":"Comes back to me the moment I need","start":35.7,"end":40.0},{"text":"Turn what you watch into what you know","start":40.7,"end":47.2},{"text":"Oh","start":47.5,"end":54.0}],"sections":[{"name":"intro","start":0.0,"end":16.4},{"name":"verse","start":16.4,"end":30.5},{"name":"chorus","start":30.5,"end":47.5},{"name":"outro","start":47.5,"end":61.1}],"notes":"Drums start at 0:30.5 and end at 1:01.1."}