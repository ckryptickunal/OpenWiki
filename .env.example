# Copy this file to `.env` and fill in your keys. NEVER commit `.env`.

# YouTube Data API v3 key — channel discovery and video metadata.
# Get one at: https://console.cloud.google.com/  → APIs & Services → YouTube Data API v3
# Not required for a single-video caption fetch (titles will be "Unknown").
YOUTUBE_API_KEY=

# Google Gemini API key — wiki ingest (entity/topic extraction).
# Get one at: https://aistudio.google.com/apikey
# Not required for extract, lint (without --gemini), or ingest --analysis-file.
GEMINI_API_KEY=

# --- Optional model overrides (defaults are used if unset) ---
# GEMINI_MODEL=gemini-3.1-flash-lite          # ingestion
# GEMINI_MODEL_LINT=gemini-2.5-flash          # wiki lint pass (--gemini)

# Optional SOCKS/HTTP proxy for YouTube caption fetches (e.g. local Tor).
# YOUTUBE_PROXY=socks5://127.0.0.1:9050

# Optional workspace root if you do not pass --root.
# WIKI_BLOCKS_ROOT=
