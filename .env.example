# Copy to `.env` in your workspace and fill in what you need. NEVER commit `.env`.

# --- YouTube -----------------------------------------------------------------
# YouTube Data API v3 key: channel/playlist listing and full video metadata.
# Get one: https://console.cloud.google.com/apis/library/youtube.googleapis.com
# Not needed for single videos (title/channel come from YouTube oEmbed).
YOUTUBE_API_KEY=

# Optional proxy for caption downloads if YouTube blocks your IP (e.g. local Tor).
# YOUTUBE_PROXY=socks5://127.0.0.1:9050

# --- LLM for `openwiki ingest` and `lint --review` ----------------------------
# Pick one provider. Auto-detected if LLM_PROVIDER is unset.
# LLM_PROVIDER=gemini   # or: openai

# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_MODEL_LINT=gemini-3.1-flash-lite

# Any OpenAI-compatible API: OpenAI, OpenRouter, Groq, Ollama, LM Studio...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_BASE_URL=http://localhost:11434/v1    # Ollama (no key needed)
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_MODEL_LINT=

# --- Workspace ----------------------------------------------------------------
# Used when you omit --root.
# OPENWIKI_ROOT=
